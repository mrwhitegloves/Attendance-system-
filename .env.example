# Copy to .env and fill in. Never commit .env.
# Production database (used when NODE_ENV=production) and development database.
MONGO_URI=
MONGO_URI_DEV=

# First CEO account: created once at start-up if no CEO exists (sign in with the email or username).
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Private S3 bucket for selfies and documents (optional; without it photos are not stored).
AWS_REGION=ap-south-2
AWS_S3_IAM_ACCESS_KEY_ID=
AWS_S3_IAM_SECRET_ACCESS_KEY=
S3_PROD_BUCKET=
S3_DEV_BUCKET=

# Web push (npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mrwhitegloves.com

# Optional: days a sign-in lasts (default 30).
SESSION_DAYS=30
